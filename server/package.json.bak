{
  "name": "invoice-generator-server",
  "version": "1.0.0",
  "description": "Invoice generator backend API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "vitest",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "puppeteer": "^25.4.0",
    "stripe": "^17.5.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "puppeteer@23.11.1": true
  }
}
