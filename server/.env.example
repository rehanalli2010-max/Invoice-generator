# Server
PORT=3000

# Database
DATABASE_URL=./data/invoices.db

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production, this MUST be set via environment variable. In development, a secure random value is generated at startup.
JWT_SECRET=your-super-secret-jwt-secret-min-64-chars

# Encryption key for AES-256-GCM (used for encrypting sensitive data like email passwords)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, this MUST be set via environment variable. In development, a secure random value is generated at startup.
ENCRYPTION_KEY=your-32-char-encryption-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_MONTHLY_PRICE=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE=price_pro_annual
STRIPE_BUSINESS_MONTHLY_PRICE=price_business_monthly
STRIPE_BUSINESS_ANNUAL_PRICE=price_business_annual

# Frontend URL (for CORS and Stripe redirects)
CLIENT_URL=http://localhost:3000

# Google AdSense
GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
GOOGLE_ADSENSE_SLOT=xxxxxxxxxx

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379

# Cron jobs
CRON_ENABLED=true
INSTANCE_ROLE=leader

# Node environment
NODE_ENV=development